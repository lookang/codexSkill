{
  "name": "sls-playwright-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guarded, resumable Playwright automation for SLS Community Gallery module migration.",
  "scripts": {
    "sls:auth": "node scripts/auth.mjs",
    "sls:one-shot": "node scripts/one-shot.mjs",
    "sls:gamify": "node scripts/module-action.mjs gamify",
    "sls:add-teacher": "node scripts/module-action.mjs add-teacher",
    "sls:inspect": "node scripts/run.mjs inspect",
    "sls:apply": "node scripts/run.mjs apply",
    "sls:resume": "node scripts/run.mjs resume",
    "trace:show": "playwright show-trace",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-all.mjs",
    "sls:scaffold": "node scripts/scaffold-config.mjs",
    "sls:scan": "node scripts/run.mjs scan",
    "sls:discover": "node scripts/run.mjs discover",
    "sls:selftest": "node scripts/selftest.mjs",
    "sls:sheet": "node scripts/sheet.mjs",
    "sls:harvest": "node scripts/harvest-dictionaries.mjs",
    "sls:tag": "node scripts/run.mjs tag",
    "sls:thumbnail": "node scripts/module-action.mjs thumbnail",
    "sls:page-break": "node scripts/page-break.mjs",
    "sls:remove-copy": "node scripts/remove-copy.mjs",
    "sls:rename-titles": "node scripts/rename-titles.mjs",
    "sls:revert-ast-titles": "node scripts/rename-titles.mjs --remove-prefix",
    "sls:acp-interactive": "node scripts/acp-interactive.mjs",
    "sls:gpt-interactive": "node scripts/acp-interactive.mjs --provider chatgpt",
    "sls:record": "node scripts/record-workflow.mjs",
    "sls:selected": "node scripts/selected-workflow.mjs",
    "sls:smoke-actions": "node scripts/smoke-module-actions.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  }
}
